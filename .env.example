# Copy to a local .env file and fill with credentials outside version control.
BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
BOT_ADMIN_IDS=REPLACE_WITH_TELEGRAM_USER_ID

# Use an HTTPS Panel URL with normal certificate verification enabled.
# For the local lab, use https://localhost:8443 and set PANEL_CA_BUNDLE to the
# path of the lab's local Caddy root certificate.
PANEL_API_URL=https://panel.example.invalid
PANEL_API_TOKEN=REPLACE_WITH_SCOPED_REWAVE_API_TOKEN
PANEL_CA_BUNDLE=

# Required only for admin grant; must be the UUID of the Panel Internal Squad
# assigned to the subscriber inbound.
PANEL_INTERNAL_SQUAD_UUID=

# Optional Platega payments. Set both values to enable payments and callbacks.
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=

# Enable traffic packages only after adding the users:update Panel API scope.
ENABLE_TRAFFIC_PLANS=0

# FREE access needs users:update and users:reset-traffic Panel scopes.
# Leave disabled until the Panel's daily reset schedule is verified in UTC.
ENABLE_FREE_ACCESS=0

# Used by the production Caddy template; set the actual apex host for deployment.
APEX_DOMAIN=example.com

# Official resources. An empty URL hides its button. Existing variable names remain valid.
BRAND_NAME=Jopes VPN
COMMUNITY_URL=https://t.me/JopesVpnChat
REVIEWS_URL=https://t.me/JopesVpnReviews
RESOURCES_URL=https://t.me/addlist/cEJd4DRCx25kMmEy

# Balance gifts: ASCII codes, persistent per-account and global attempt limits.
# Rewards are in kopecks. Administrators create codes from the bot; no codes in env.
PROMO_MIN_CODE_LENGTH=8
PROMO_MAX_CODE_LENGTH=48
PROMO_MAX_ATTEMPTS=5
PROMO_GLOBAL_MAX_ATTEMPTS=300
PROMO_ATTEMPT_WINDOW_SECONDS=900
PROMO_MAX_REWARD_MINOR=100000
PROMO_MAX_VALID_DAYS=365
PROMO_MAX_USES=10000

# Read-only Telegram health probe, also used by Docker and external monitoring.
HEALTH_PROBE_INTERVAL_SECONDS=60
HEALTH_PROBE_MAX_AGE_SECONDS=180

# Direct runs: empty means forwarded address headers are not trusted.
# Production Compose pins this to the Caddy backend address.
PLATEGA_TRUSTED_PROXY_IP=

# Owner-only operational checks. UTC 07:00 = Moscow 10:00.
OPS_POLL_SECONDS=300
OPS_DEVICE_SCAN_SECONDS=3600
OPS_SUPPORT_REMINDER_HOURS=2
OPS_REPEAT_TRIAL_THRESHOLD=3
OPS_REFERRAL_DAILY_THRESHOLD=5
OPS_TICKET_RETENTION_DAYS=90
OPS_EVENT_RETENTION_DAYS=30
OPS_SUMMARY_HOUR_UTC=7
OPS_MIN_AVAILABLE_MB=500
OPS_CRITICAL_AVAILABLE_MB=250
OPS_MAX_SWAP_PERCENT=75
OPS_MAX_DISK_PERCENT=85
OPS_CRITICAL_DISK_PERCENT=95
OPS_MIN_DISK_FREE_GB=5
OPS_CRITICAL_DISK_FREE_GB=2
OPS_MAX_BACKUP_AGE_MINUTES=75

# Disposable automatic probes; restricted prefix is checked before deletion.
OPS_TEST_USER_PREFIX=ops_probe_
OPS_TEST_DURATION_MINUTES=15

# Explicit recipient; must be an admin. Empty falls back only when there is one admin.
BOT_OWNER_ID=
