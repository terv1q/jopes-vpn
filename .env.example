# Copy to a local .env file and fill with credentials outside version control.
BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
BOT_ADMIN_IDS=REPLACE_WITH_TELEGRAM_USER_ID

# Use an HTTPS Panel URL with normal certificate verification enabled.
# For the local lab, use https://localhost:8443 and set PANEL_CA_BUNDLE to the
# path of the lab's local Caddy root certificate.
PANEL_API_URL=https://panel.example.invalid
PANEL_API_TOKEN=REPLACE_WITH_SCOPED_REWAVE_API_TOKEN
PANEL_CA_BUNDLE=

# Required only for admin grant; must be the UUID of the Panel Internal Squad
# assigned to the subscriber inbound.
PANEL_INTERNAL_SQUAD_UUID=

# Optional Platega payments. Set both values to enable payments and callbacks.
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=

# Enable traffic packages only after adding the users:update Panel API scope.
ENABLE_TRAFFIC_PLANS=0

# FREE access needs users:update and users:reset-traffic Panel scopes.
# Leave disabled until the Panel's daily reset schedule is verified in UTC.
ENABLE_FREE_ACCESS=0
