{
	admin localhost:2019
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2
	}
}

{$PANEL_DOMAIN} {
	encode zstd gzip
	header {
		Alt-Svc "clear"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	reverse_proxy remnawave:3000
}

# Branded Remnawave subscription page. It must be served at a host root, not
# under a path, because its frontend assets live at /assets.
{$CONNECT_DOMAIN} {
	encode zstd gzip
	header {
		Alt-Svc "clear"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	@platega path /platega/callback /platega/healthz
	handle @platega {
		reverse_proxy bot:8081 {
			header_up X-Real-IP {remote_host}
		}
	}
	@bot_health path /healthz
	handle @bot_health {
		reverse_proxy bot:8081
	}
	@support path /support /support/*
	handle @support {
		reverse_proxy ticket-forum:8080 {
			header_up X-Real-IP {remote_host}
		}
	}
	# The subscription page only has per-subscription paths; its root has no
	# content and the upstream aborts the request. Send visitors to the channel.
	@root path /
	redir @root https://t.me/{$TRIAL_CHANNEL_USERNAME} 302
	reverse_proxy remnawave-subscription-page:3010
}

# The apex and www names get publicly trusted certificates and redirect to the
# Panel.
{$APEX_DOMAIN}, www.{$APEX_DOMAIN} {
	redir https://{$PANEL_DOMAIN}{uri} permanent
}
