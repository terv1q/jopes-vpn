{
  "tag": "JOPES_HYSTERIA2_IN",
  "listen": "0.0.0.0",
  "port": 443,
  "protocol": "hysteria",
  "settings": {
    "clients": [],
    "version": 2
  },
  "streamSettings": {
    "network": "hysteria",
    "security": "tls",
    "hysteriaSettings": {
      "version": 2,
      "masquerade": {
        "type": "proxy",
        "url": "https://{$CONNECT_DOMAIN}",
        "rewriteHost": true
      }
    },
    "tlsSettings": {
      "alpn": [
        "h3"
      ],
      "certificates": [
        {
          "certificateFile": "/etc/remnawave/hysteria2-certs/fullchain.pem",
          "keyFile": "/etc/remnawave/hysteria2-certs/privkey.pem"
        }
      ]
    }
  }
}
